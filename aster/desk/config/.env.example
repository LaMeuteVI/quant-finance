# Copy to desk/config/.env (gitignored) or export in a HUMAN shell. Never paste keys in chat.
# Keys: trade-only, withdrawals DISABLED, IP whitelist ON, dedicated sub-account.

# Testnet (https://testnet.binance.vision)
ASTER_BINANCE_TESTNET_API_KEY=
ASTER_BINANCE_TESTNET_API_SECRET=

# Live — leave empty until a hypothesis is promoted to live_pilot by you.
ASTER_BINANCE_API_KEY=
ASTER_BINANCE_API_SECRET=

# Live arming switch. Set to 1 only in the shell/cron that runs `aster trade run --broker live`.
# ASTER_LIVE_ARMED=1
